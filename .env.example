# summery 環境變數範例（可直接 source，或寫進 systemd/docker compose 的 env）
# 大檔建議用 SUMMERY_<區塊>_<欄位> 或 SUMMERY__<區塊>__<欄位> 覆蓋任何設定欄位。

# --- API 金鑰（絕對不要 commit 真實金鑰）---
ASR_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# 單一金鑰同時給 ASR 與 LLM 時也可以用：OPENAI_API_KEY

# --- Gateway 位置（OpenAI 相容端點）---
# OpenAI:      https://api.openai.com/v1
# Azure:       https<region>.openai.azure.com/openai/deployments/<deployment>?api-version=2024-10-21
# vLLM/自建:   http://127.0.0.1:8000/v1
OPENAI_BASE_URL=https://api.openai.com/v1
SUMMERY__ASR__BASE_URL=https://api.openai.com/v1
SUMMERY__ASR__MODEL=whisper-1
SUMMERY__LLM__BASE_URL=https://api.openai.com/v1
SUMMERY__LLM__MODEL=gpt-4o-mini

# --- 路徑與行為 ---
# .env 會被 summery 自動載入（目前目錄的 .env）；--env-file 可指定別份、--no-env-file 或 SUMMERY_DOTENV=0 可關閉。
# 指向自訂 TOML（檔案不存在時只會警告，不會讓指令失敗）：
#SUMMERY_CONFIG=./my.toml
SUMMERY_WORK_DIR=./.summery_work
SUMMERY_LOG_LEVEL=INFO
# SUMMERY__ASR__MAX_CONCURRENCY=6
# SUMMERY__CHUNKING__TARGET_SECONDS=900
# SUMMERY__OUTPUT__FORMATS=md,srt
# --- 接真實 Gateway 常調的兩項 ---
# 端點不收 m4a 時（400 Invalid or unsupported audio file）：
# SUMMERY__AUDIO__CODEC=mp3
# 推理型模型（thinking 也會吃掉 max_tokens）：
# SUMMERY__LLM__MAX_OUTPUT_TOKENS=8000
# SUMMERY__ASR__EXTRA_PARAMS=dialect=zh-TW,official_whisper=true
